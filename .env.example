# Copy to .env.local for local development. Never commit real values.

NODE_ENV=development

# PostgreSQL. These defaults match the `db` service in docker-compose.yml.
DATABASE_URL=postgres://dayboard:dayboard@localhost:5432/dayboard

# Auth (Better Auth). Generate the secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=
# Public origin of the app. Must be the https:// origin in production.
BETTER_AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional OAuth sign-in. Set both values of a pair, or neither.
# Callback URL: {BETTER_AUTH_URL}/api/auth/callback/google (and /github)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Email (Resend). Required in production. When RESEND_API_KEY is empty in
# development, emails are printed to the server console instead of sent.
RESEND_API_KEY=
EMAIL_FROM=Dayboard <hello@example.com>

# Test runs only (Playwright / CI). Turns on the console email sender in a
# production build and writes emails to .e2e/emails.jsonl so tests can read
# verification, reset and sign-in links. Never set this in a real deployment.
E2E=
# Optional: where captured emails are written (default .e2e/emails.jsonl).
E2E_EMAIL_FILE=

# AI assistant (feature 05). Leave AI_PROVIDER empty to use the mock in development and the
# `anthropic` provider in production. Use `gemini` for Google's free tier (key from
# https://aistudio.google.com/apikey); its default models are gemini-3.5-flash and gemini-3.5-flash-lite. With a real provider and no AI_API_KEY, AI is switched off
# for everyone and every AI button disappears; the rest of the app is unaffected.
# The key is server-only: never prefix it with NEXT_PUBLIC_.
AI_PROVIDER=
AI_API_KEY=
# Default model for structured and streamed work, and a cheaper one for short jobs.
AI_MODEL=claude-sonnet-5-5
AI_MODEL_FAST=claude-haiku-4-5-20251001
# Models tried, in order, when the chosen one fails for a "try later" reason (free quota used up,
# overloaded, not available). Leave empty for the built-in list: for Gemini, 3.5 Flash then 3.5
# Flash-Lite, 2.5 Flash and 2.5 Flash-Lite. A comma list replaces it; `none` turns fallback off.
AI_FALLBACK_MODELS=
# Optional: a proxy or gateway that speaks the provider's API.
AI_BASE_URL=
# Per person. A day is the person's local day.
AI_LIMIT_PER_MINUTE=10
AI_LIMIT_PER_DAY=100
# Mock provider only: `error` makes every call fail, `slow` delays them (for demos and tests).
AI_MOCK_MODE=

# Files and attachments (V2 feature 09). Leave STORAGE_DRIVER empty to hide the feature: the rest of
# the app works without it. `s3` is any S3-compatible service; the V2 provider is Backblaze B2 (see
# specs/v2/features/09 §3.2 for the one-time account setup and ADR 0010). `disk` writes to a local
# folder for development and is refused in production. Tests use an in-memory store (E2E=true).
# The key ID and the secret are server-only: never prefix them with NEXT_PUBLIC_.
STORAGE_DRIVER=
# B2: https://s3.<region>.backblazeb2.com  (the region is the middle part, for example us-west-004)
STORAGE_ENDPOINT=
STORAGE_REGION=
STORAGE_BUCKET=
# The application key restricted to this bucket (never the master key).
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Set true if the SDK reports a host or certificate error for the bucket address.
STORAGE_FORCE_PATH_STYLE=false
# disk driver only: the folder (default .storage-dev).
STORAGE_DISK_DIR=
# Per person, and for everyone together (keeps total storage under B2's free 10 GB).
STORAGE_QUOTA_MB=500
STORAGE_TOTAL_LIMIT_MB=9000
